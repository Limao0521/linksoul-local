# Copia este archivo a `.env` y ajusta los valores.
# `cp .env.example .env`  (Linux/robot)  |  `Copy-Item .env.example .env`  (Windows)

# ============================== SERVIDOR LLM ==================================
# Imagen base del motor (los overrides de compose ya la fijan; rara vez se toca)
#   CPU x86/arm64:  ghcr.io/ggml-org/llama.cpp:server
#   x86 + CUDA:     ghcr.io/ggml-org/llama.cpp:server-cuda12
#   Jetson (robot): dustynv/llama_cpp:r36.4.0
#LLM_BASE_IMAGE=ghcr.io/ggml-org/llama.cpp:server

# Puerto expuesto en el host para la API OpenAI-compatible
LLM_PORT=8080

# Modelo (ruta DENTRO del contenedor; el volumen ./models se monta en /models)
MODEL_PATH=/models/Qwen3-4B-Q4_K_M.gguf

# Contexto: 2048 basta para conversación con personalidad y minimiza RAM/latencia
CTX_SIZE=2048

# Threads de CPU (deja ~2 cores libres para el sistema; Orin NX tiene 8)
CPU_THREADS=6

# Capas offloadadas a GPU: 0=CPU, 99=todas (los overrides GPU ya lo fijan)
NGL=0

# Slots de atención paralela
PARALLEL=2

# Tipo de cache KV (q8_0 = -40% memoria, requiere flash attention)
KV_CACHE_TYPE=q8_0

# Decodificación especulativa (opcional; descarga también Qwen3-0.6B como draft):
#DRAFT_MODEL=/models/Qwen3-0.6B-Q4_K_M.gguf

# Flags extra libres para llama-server (última palabra, pisa lo anterior)
#EXTRA_ARGS=

# =========================== BRIDGE LINKSOUL ==================================
# Credenciales de tu aplicación en la plataforma abierta de AgiBot:
# https://open.agibot.com/cn/console/apps  (crear app -> capacidad "AgentSDK")
# El appSecret solo se muestra UNA vez al crearlo: guárdalo bien.
AGIBOT_APP_ID=
AGIBOT_APP_KEY=
AGIBOT_APP_SECRET=
# Código del agente creado en LinkSoul (Agent Center -> Agent Templates -> SDK)
AGIBOT_AGENT_CODE=

# Gateway WebSocket del Agent SDK (no tocar salvo que AgiBot lo cambie)
LINKSOUL_WS_URL=wss://open.agibot.com/api/V1/open-portal/app/wss/agent-sdk
# ASR_2_LLM (recomendado): el robot hace ASR y TTS (conserva la voz configurada
# en LinkSoul); el bridge solo pone el TEXTO del LLM local.
# ASR_VIDEO_2_VLM: igual pero recibiendo también contexto de vídeo.
# AUDIO_2_TTS / ASR_2_TTS: exigirían generar el audio TTS en el bridge (TODO).
LINKSOUL_CALLBACK_TYPE=ASR_2_LLM

# --- Parámetros de conversación del bridge ---
# URL del servidor LLM (desde dentro de la red de Docker compose)
LLM_BASE_URL=http://llm-server:8080/v1
LLM_API_KEY=not-needed
LLM_MODEL=local
# Tope de tokens por respuesta: respuestas cortas = conversación más fluida
MAX_TOKENS=300
TEMPERATURE=0.7
# Qwen3 sin fase "thinking": ahorra 1-3s antes del primer token
ENABLE_THINKING=false
# Turnos de memoria por robot (pares usuario/asistente)
HISTORY_TURNS=8
